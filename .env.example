# Copy to .env for local use. On Vercel, set these in Project Settings > Environment Variables.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0
ADMIN_URL=manage-xyz123/
# Postgres (Neon or Supabase). Leave empty locally to use SQLite.
DATABASE_URL=
# S3-compatible storage for uploads (Supabase Storage S3 works). Leave S3_BUCKET empty locally.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
# Public host + path where files are served, no https://
# Supabase example: <project-ref>.supabase.co/storage/v1/object/public/<bucket>
S3_PUBLIC_DOMAIN=
